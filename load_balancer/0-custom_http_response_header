#!/usr/bin/env bash
# Configures a brand new Ubuntu machine with Nginx and a custom
# HTTP response header (X-Served-By) containing the server's hostname.
# shellcheck disable=SC2154,SC2016

sudo apt-get update -y
sudo apt-get install -y nginx

echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null

echo 'add_header X-Served-By $hostname;' | sudo tee /etc/nginx/conf.d/custom_header.conf > /dev/null

sudo nginx -t
sudo service nginx restart
